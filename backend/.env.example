# Copy to .env and fill in
# Real LLM via OpenRouter (recommended) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Or direct OpenAI (used only when OPENROUTER_API_KEY is empty)
OPENAI_API_KEY=
# Optional: tavily / search API
# TAVILY_API_KEY=
# Optional: set to use Postgres (Railway injects this automatically).
# Empty = in-memory storage (local dev).
# DATABASE_URL=postgresql://user:pass@localhost:5432/agentco
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
# mock | openai (auto = openai if key exists, else mock)
LLM_MODE=auto
OPENAI_MODEL=gpt-4o-mini
